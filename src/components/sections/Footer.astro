---
import { legalPaths, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Replace with the club's real profiles (or remove entries).
const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/' },
  { label: 'Facebook', href: 'https://www.facebook.com/' },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand">
      <img src="/logo/tsv-steinsfurt.svg" alt="TSV Phönix Steinsfurt Logo" width="40" height="45" />
      <strong>TSV Phönix Steinsfurt</strong>
    </div>

    <div class="links">
      <span>{t.footer.follow}:</span>
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
    </div>

    <nav class="legal" aria-label={`${t.footer.imprint} / ${t.footer.privacy}`}>
      <a href={legalPaths.imprint[lang]}>{t.footer.imprint}</a>
      <a href={legalPaths.privacy[lang]}>{t.footer.privacy}</a>
    </nav>

    <p class="copy">© {year} TSV Phönix Steinsfurt e.V. · {t.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-ink);
    color: rgb(255 255 255 / 0.8);
    padding-block: 3rem;
    font-size: 0.95rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    font-size: 1.1rem;
  }
  .links, .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
  }
  .links a, .legal a {
    color: #fff;
    padding: 0.25rem 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-highlight);
  }
  .copy {
    flex-basis: 100%;
    opacity: 0.6;
    font-size: 0.85rem;
  }
</style>
