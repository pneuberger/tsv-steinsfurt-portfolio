---
import { Image } from 'astro:assets';
import { img } from '../../lib/images';
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

/**
 * Player quotes. Each item: quote (paragraphs separated by a blank line "\n\n"),
 * name, role (may be ""), optional image key (src/assets/photos/<key>.jpg).
 * Without an image, the player's initials are shown in a circle.
 */
type Item = { quote: string; name: string; role: string; image?: string };
const items = t.testimonials.items as Item[];
const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<section id="stimmen" class="section voices">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{t.testimonials.eyebrow}</p>
      <h2>{t.testimonials.title}</h2>
    </div>

    <ul class="quotes stagger">
      {
        items.map((q) => (
          <li class="quote reveal">
            <blockquote>
              {q.quote.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
            </blockquote>
            <div class="who">
              {q.image ? (
                <Image src={img(q.image)} alt="" width={112} height={112} />
              ) : (
                <span class="avatar" aria-hidden="true">{initials(q.name)}</span>
              )}
              <div>
                <strong>{q.name}</strong>
                {q.role && <span class="role">{q.role}</span>}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .voices {
    background: linear-gradient(180deg, var(--c-bg), var(--c-tint));
  }
  .quotes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.25rem 1.5rem; /* extra row gap for the big quote mark */
    grid-template-columns: 1fr;
  }
  @media (min-width: 800px) {
    .quotes { grid-template-columns: repeat(2, 1fr); } /* 4 quotes → 2×2 */
  }
  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow);
    position: relative;
  }
  .quote:nth-child(odd) { rotate: -0.6deg; }
  .quote:nth-child(even) { rotate: 0.6deg; }
  .quote::before {
    content: '“';
    position: absolute;
    top: -1.6rem;
    left: 1.25rem;
    font-size: 6rem;
    line-height: 1;
    font-weight: 800;
    color: var(--c-primary);
  }
  blockquote p {
    font-size: 1.08rem;
    font-weight: 500;
  }
  blockquote p + p { margin-top: 0.8rem; }
  .who {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .who :global(img),
  .avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .who :global(img) { object-fit: cover; }
  .avatar {
    display: grid;
    place-items: center;
    background: var(--c-primary);
    color: #fff;
    font-weight: 800;
    font-size: 1.15rem;
  }
  .who strong { display: block; }
  .role { color: var(--c-ink-soft); font-size: 0.9rem; }
</style>
