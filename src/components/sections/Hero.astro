---
import { getImage, Image } from 'astro:assets';
import Wave from '../ui/Wave.astro';
import bgDesktop from '../../assets/hero/hero-bg-desktop.jpg';
import bgMobile from '../../assets/hero/hero-bg-mobile.jpg';
import emblem from '../../assets/hero/hero-emblem.png';
import type { Dictionary } from '../../i18n';
import { accessGate } from '../../access-gate';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

// Background: blurred flames from the phoenix emblem (no lettering). Separate crops for
// landscape (desktop) and portrait (phones); the sharp emblem sits on top as its own element,
// next to the text on desktop and above it on phones – so it never collides with the headline.
const bgLandscape = await getImage({ src: bgDesktop, widths: [1280, 1920, 2560], format: 'webp' });
const bgPortrait = await getImage({ src: bgMobile, widths: [540, 1080], format: 'webp' });
const bgFallback = await getImage({ src: bgDesktop, width: 1920, format: 'jpg' });
---

<header class="hero">
  <picture class="hero-bg" aria-hidden="true">
    <source media="(orientation: portrait)" type="image/webp" srcset={bgPortrait.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={bgLandscape.srcSet.attribute} sizes="100vw" />
    <img src={bgFallback.src} alt="" width="1920" height="1080" fetchpriority="high" />
  </picture>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    <Image class="hero-emblem" src={emblem} alt="" widths={[320, 480, 640]} sizes="(min-width: 900px) 34vw, 60vw" loading="eager" />
    <div class="hero-text">
      <img class="crest" src="/logo/tsv-steinsfurt.svg" alt="TSV Phönix Steinsfurt Logo" width="96" height="109" />
      <p class="hero-eyebrow">{t.hero.eyebrow}</p>
      {/* data-greeting: template for the personal greeting (staging only, script injected in astro.config.mjs) */}
      <h1 data-greeting={accessGate ? t.hero.titleGreeting : undefined}>{t.hero.title}</h1>
      <div class="hero-ctas">
        <a class="btn btn-accent" href="#offer">{t.hero.cta} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <a class="scroll-hint" href="#about">
    <span>{t.hero.scroll}</span>
    <span class="ball" aria-hidden="true">⚽</span>
  </a>
  <Wave />
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--c-primary-dark);
    isolation: isolate;
  }
  .hero-bg,
  .hero-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* phoenix emblem: above the text on phones, own column right of the text on desktop */
  .hero-content {
    display: grid;
    align-items: center;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
  }
  .hero :global(.hero-emblem) {
    width: min(52vw, 15rem);
    height: auto;
    border-radius: 50%;
    filter: drop-shadow(0 0 2.5rem rgb(38 89 161 / 0.75));
    animation: pop 0.9s 0.15s cubic-bezier(.2,1.4,.4,1) both;
  }
  /* phones: the emblem takes the place of the small crest (no doubled logos) */
  @media (max-width: 899px) {
    .crest { display: none; }
  }
  @media (max-width: 899px) and (max-height: 720px) {
    .hero :global(.hero-emblem) { width: min(38vw, 10rem); }
  }
  @media (min-width: 900px) {
    .hero-content { grid-template-columns: minmax(0, 1fr) clamp(14rem, 26vw, 30rem); }
    .hero :global(.hero-emblem) { grid-column: 2; grid-row: 1; width: 100%; }
    .hero-text { grid-column: 1; grid-row: 1; }
    /* the text column is narrower next to the emblem: slightly smaller headline → 3 lines instead of 4 */
    h1 { font-size: clamp(2.6rem, 0.8rem + 3.6vw, 4.75rem); }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 20% 80%, rgb(38 89 161 / 0.5), transparent 60%),
      linear-gradient(180deg, rgb(0 0 64 / 0.35) 0%, rgb(0 0 64 / 0.8) 100%);
  }
  .hero-content {
    padding-block: 7rem 9rem;
    max-width: var(--max);
  }
  .crest {
    width: clamp(5rem, 4rem + 3vw, 6.5rem);
    height: auto;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.3));
    animation: pop 0.8s cubic-bezier(.2,1.6,.4,1) both;
  }
  .hero-eyebrow {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--c-highlight);
    margin-bottom: 1rem;
  }
  h1 {
    max-width: 22ch; /* wide enough to keep "Phönix-Gemeinschaft" on one line on desktop */
    animation: rise 0.9s 0.1s cubic-bezier(.2,.8,.2,1) both;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
    animation: rise 0.9s 0.25s cubic-bezier(.2,.8,.2,1) both;
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(3rem, 7vw, 6rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
  }
  .ball {
    font-size: 1.5rem;
    animation: bounce 1.6s infinite;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.4) rotate(-20deg); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px) rotate(180deg); }
  }
  @media (max-height: 640px) {
    .scroll-hint { display: none; }
  }
</style>
