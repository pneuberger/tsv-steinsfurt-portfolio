---
import VideoClip from '../ui/VideoClip.astro';
import Wave from '../ui/Wave.astro';
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<header class="hero">
  <VideoClip name="hero" label={t.hero.title} class="hero-video" />
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    <img class="crest" src="/favicon.svg" alt="TSV Steinsfurt" width="72" height="72" />
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title}</h1>
    <p class="hero-sub">{t.hero.subtitle}</p>
    <div class="hero-ctas">
      <a class="btn btn-accent" href="#kontakt">{t.hero.cta} <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="#angebot">{t.hero.secondary}</a>
    </div>
  </div>

  <a class="scroll-hint" href="#ueber-uns">
    <span>{t.hero.scroll}</span>
    <span class="ball" aria-hidden="true">⚽</span>
  </a>
  <Wave />
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--c-primary-dark);
    isolation: isolate;
  }
  .hero :global(.hero-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 20% 80%, rgb(15 107 69 / 0.55), transparent 60%),
      linear-gradient(180deg, rgb(11 61 46 / 0.35) 0%, rgb(11 61 46 / 0.75) 100%);
  }
  .hero-content {
    padding-block: 7rem 9rem;
    max-width: var(--max);
  }
  .crest {
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.3));
    animation: pop 0.8s cubic-bezier(.2,1.6,.4,1) both;
  }
  .hero-eyebrow {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--c-accent);
    margin-bottom: 1rem;
  }
  h1 {
    max-width: 14ch;
    animation: rise 0.9s 0.1s cubic-bezier(.2,.8,.2,1) both;
  }
  .hero-sub {
    max-width: 36rem;
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    opacity: 0.92;
    animation: rise 0.9s 0.25s cubic-bezier(.2,.8,.2,1) both;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
    animation: rise 0.9s 0.4s cubic-bezier(.2,.8,.2,1) both;
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(3rem, 7vw, 6rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
  }
  .ball {
    font-size: 1.5rem;
    animation: bounce 1.6s infinite;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.4) rotate(-20deg); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px) rotate(180deg); }
  }
  @media (max-height: 640px) {
    .scroll-hint { display: none; }
  }
</style>
