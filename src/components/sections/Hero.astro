---
import { getImage } from 'astro:assets';
import Wave from '../ui/Wave.astro';
import bgDesktop from '../../assets/hero/hero-bg-desktop.jpg';
import bgMobile from '../../assets/hero/hero-bg-mobile.jpg';
import type { Dictionary } from '../../i18n';
import { accessGate } from '../../access-gate';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

// Background: blue phoenix in flames. Landscape version (phoenix top right, text on the dark
// left side) and portrait version for phones (phoenix at the top, text in the dark lower half).
const bgLandscape = await getImage({ src: bgDesktop, widths: [1280, 1920, 2560, 3840], format: 'webp' });
const bgPortrait = await getImage({ src: bgMobile, widths: [540, 1080], format: 'webp' });
const bgFallback = await getImage({ src: bgDesktop, width: 1920, format: 'jpg' });
---

<header class="hero">
  <picture class="hero-bg" aria-hidden="true">
    <source media="(orientation: portrait)" type="image/webp" srcset={bgPortrait.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={bgLandscape.srcSet.attribute} sizes="100vw" />
    <img src={bgFallback.src} alt="" width="1920" height="1080" fetchpriority="high" />
  </picture>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    <img class="crest" src="/logo/tsv-steinsfurt.svg" alt="TSV Phönix Steinsfurt Logo" width="96" height="109" />
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    {/* data-greeting: template for the personal greeting (staging only, script injected in astro.config.mjs) */}
    <h1 data-greeting={accessGate ? t.hero.titleGreeting : undefined}>{t.hero.title}</h1>
    <div class="hero-ctas">
      <a class="btn btn-accent" href="#offer">{t.hero.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <a class="scroll-hint" href="#about">
    <span>{t.hero.scroll}</span>
    <span class="ball" aria-hidden="true">⚽</span>
  </a>
  <Wave />
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    color: #fff;
    overflow: hidden;
    background: var(--c-primary-dark);
    isolation: isolate;
  }
  .hero-bg,
  .hero-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* landscape art: anchored right, so narrow windows crop the empty dark left side, not the phoenix */
  .hero-bg img { object-position: 100% 0; }
  /* desktop: slightly smaller headline so it stays on the dark left side, clear of the phoenix */
  @media (min-width: 900px) {
    h1 { font-size: clamp(2.6rem, 0.8rem + 3.6vw, 4.75rem); }
  }
  /* phones (portrait): phoenix fills the top, text sits in the dark lower half; the phoenix
     replaces the small crest there */
  @media (orientation: portrait) and (max-width: 899px) {
    .hero { align-items: end; }
    .hero-content { padding-block: 7rem 8.5rem; }
    .crest { display: none; }
  }
  /* portrait art (phones, upright tablets): anchored at the top and enlarged so the phoenix fills
     the upper part; no darkening there – the overlay only starts where the text is */
  @media (orientation: portrait) {
    .hero-bg img {
      object-position: 50% 0;
      transform: scale(1.2);
      transform-origin: 50% 0;
    }
    .hero > .hero-overlay { /* higher specificity: the base rule below comes later */
      background: linear-gradient(180deg, transparent 0%, transparent 38%, rgb(0 0 64 / 0.55) 65%, rgb(0 0 64 / 0.85) 100%);
    }
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 20% 80%, rgb(38 89 161 / 0.35), transparent 60%),
      linear-gradient(180deg, rgb(0 0 64 / 0.05) 0%, rgb(0 0 64 / 0.25) 55%, rgb(0 0 64 / 0.7) 100%);
  }
  .hero-content {
    padding-block: 7rem 9rem;
    max-width: var(--max);
  }
  .crest {
    width: clamp(5rem, 4rem + 3vw, 6.5rem);
    height: auto;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.3));
    animation: pop 0.8s cubic-bezier(.2,1.6,.4,1) both;
  }
  .hero-eyebrow {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--c-highlight);
    margin-bottom: 1rem;
  }
  h1 {
    max-width: 22ch; /* wide enough to keep "Phönix-Gemeinschaft" on one line on desktop */
    animation: rise 0.9s 0.1s cubic-bezier(.2,.8,.2,1) both;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.25rem;
    animation: rise 0.9s 0.25s cubic-bezier(.2,.8,.2,1) both;
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(3rem, 7vw, 6rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.85;
  }
  .ball {
    font-size: 1.5rem;
    animation: bounce 1.6s infinite;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.4) rotate(-20deg); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px) rotate(180deg); }
  }
  @media (max-height: 640px) {
    .scroll-hint { display: none; }
  }
</style>
