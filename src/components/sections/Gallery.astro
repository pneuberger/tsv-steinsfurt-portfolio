---
import { Image, getImage } from 'astro:assets';
import { img } from '../../lib/images';
import VideoClip from '../ui/VideoClip.astro';
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;

/**
 * Bento grid of photos and clips. `size` controls the tile shape: wide | tall | big | (default 1×1).
 * Photos: key from src/assets. Clips: name of public/media/videos/<name>.mp4.
 */
type Size = 'wide' | 'tall' | 'big';
type Tile =
  | { kind: 'photo'; key: string; size?: Size }
  | { kind: 'clip'; name: string; size?: Size }
  | { kind: 'cta'; size?: Size }; // "Werde Teil davon" tile → #contact

// 4-column grid (2 on mobile): big = 2×2, wide = 2×1, tall = 1×2, default = 1×1.
// Keep the cells adding up to full rows (here 16) so the grid has no holes.
const tiles: Tile[] = [
  { kind: 'photo', key: 'gallery-01', size: 'big' }, // locker room, pink/black jerseys
  { kind: 'photo', key: 'gallery-05', size: 'tall' }, // "Der Phönix hebt wieder ab!"
  { kind: 'photo', key: 'gallery-04' }, // locker room, white jerseys
  { kind: 'cta' },
  { kind: 'photo', key: 'gallery-02', size: 'wide' }, // team celebrating on the pitch
  { kind: 'photo', key: 'gallery-03', size: 'wide' }, // locker room, blue jerseys
  { kind: 'photo', key: 'gallery-06', size: 'wide' }, // promotion with phoenix banner
  { kind: 'photo', key: 'gallery-07', size: 'wide' }, // team in white on the pitch
];

// Large versions for the lightbox.
const large = await Promise.all(
  tiles.map((tile) => (tile.kind === 'photo' ? getImage({ src: img(tile.key), width: 1600 }) : null)),
);
---

<section id="gallery" class="section gallery">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{t.gallery.eyebrow}</p>
      <h2>{t.gallery.title}</h2>
    </div>

    <!-- Featured video: muted teaser loop; click opens the full video with sound in the lightbox -->
    <button
      type="button"
      class="feature reveal"
      data-lightbox="video"
      data-src="/media/videos/motivation.mp4"
      data-poster="/media/videos/motivation-teaser-poster.jpg"
      aria-label={t.gallery.watchFull}
    >
      <VideoClip name="motivation-teaser" label={t.gallery.watchFull} />
      <span class="feature-cta"><span class="play-icon" aria-hidden="true">▶</span>{t.gallery.watchFull}</span>
    </button>

    <ul class="bento stagger">
      {
        tiles.map((tile, i) => (
          <li class:list={['tile reveal', tile.size]}>
            {tile.kind === 'photo' ? (
              <button
                type="button"
                data-lightbox="image"
                data-src={large[i]!.src}
                data-alt={`${t.gallery.photo} ${i + 1}`}
                aria-label={`${t.gallery.open}: ${t.gallery.photo} ${i + 1}`}
              >
                <Image
                  src={img(tile.key)}
                  alt=""
                  widths={[400, 800, 1200]}
                  sizes={tile.size === 'big' || tile.size === 'wide' ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                />
              </button>
            ) : tile.kind === 'cta' ? (
              <a class="cta-tile" href="#contact">
                <img src="/logo/tsv-steinsfurt.svg" alt="" width="48" height="55" />
                <strong>{t.gallery.ctaTitle}</strong>
                <span>{t.gallery.ctaText} <span aria-hidden="true">→</span></span>
              </a>
            ) : (
              <button
                type="button"
                data-lightbox="video"
                data-src={`/media/videos/${tile.name}.mp4`}
                data-poster={`/media/videos/${tile.name}-poster.jpg`}
                aria-label={`${t.gallery.open}: ${t.gallery.clip}`}
              >
                <VideoClip name={tile.name} label={t.gallery.clip} />
                <span class="play" aria-hidden="true">▶</span>
              </button>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <dialog id="lightbox" class="lightbox">
    <button type="button" class="close" data-dialog-close aria-label={t.gallery.close}>✕</button>
    <div data-stage></div>
  </dialog>
</section>

<style>
  .cta-tile {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.35rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
    color: #fff;
    text-decoration: none;
    transition: filter 0.2s ease;
  }
  .cta-tile:hover { filter: brightness(1.12); }
  .cta-tile img { width: clamp(1.8rem, 3vw, 2.4rem); height: auto; margin-bottom: 0.2rem; }
  .cta-tile strong { font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem); line-height: 1.15; }
  .cta-tile span { font-size: 0.9rem; font-weight: 600; color: var(--c-highlight); }
  .feature {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: clamp(0.6rem, 1.5vw, 1rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--c-primary-dark);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .feature :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .feature:hover :global(video) { transform: scale(1.03); }
  .feature-cta {
    position: absolute;
    left: clamp(0.8rem, 2vw, 1.5rem);
    bottom: clamp(0.8rem, 2vw, 1.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.2rem 0.7rem 0.8rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-primary-dark);
    font-weight: 700;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease;
  }
  .feature:hover .feature-cta { transform: translateY(-2px); }
  .play-icon {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-primary);
    color: #fff;
    font-size: 0.75rem;
  }
  .bento {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(140px, 22vw, 240px);
    grid-auto-flow: dense;
    gap: clamp(0.6rem, 1.5vw, 1rem);
  }
  @media (min-width: 900px) {
    .bento { grid-template-columns: repeat(4, 1fr); }
  }
  .tile { border-radius: var(--radius); overflow: hidden; background: var(--c-line); }
  .tile.wide { grid-column: span 2; }
  .tile.tall { grid-row: span 2; }
  .tile.big { grid-column: span 2; grid-row: span 2; }
  .tile button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .tile :global(img),
  .tile :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .tile:hover :global(img),
  .tile:hover :global(video) { transform: scale(1.05); }
  .play {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-accent);
    color: var(--c-primary-dark);
    font-size: 0.9rem;
    box-shadow: var(--shadow);
  }

  .lightbox {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(92vw, 1400px);
    max-height: 90svh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(0 0 40 / 0.88);
    backdrop-filter: blur(4px);
  }
  .lightbox [data-stage] :global(img),
  .lightbox [data-stage] :global(video) {
    max-width: min(92vw, 1400px);
    max-height: 85svh;
    width: auto;
    border-radius: var(--radius);
  }
  .close {
    position: absolute;
    top: -3.25rem;
    right: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 0;
    background: #fff;
    color: var(--c-ink);
    font-size: 1.1rem;
  }
</style>
