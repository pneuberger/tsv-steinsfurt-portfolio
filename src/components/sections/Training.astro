---
import type { Dictionary } from '../../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(t.training.address)}`;
---

<section id="training" class="section training">
  <div class="container training-grid">
    <div class="reveal">
      <p class="eyebrow">{t.training.eyebrow}</p>
      <h2>{t.training.title}</h2>
      <p class="lead">{t.training.text}</p>
    </div>

    <div class="cards">
      <div class="card schedule reveal" style="--delay:80ms">
        <h3>🕖 {t.training.scheduleTitle}</h3>
        <dl>
          {
            t.training.schedule.map((row) => (
              <div class="row">
                <dt>{row.team}</dt>
                <dd>{row.times}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="card location reveal" style="--delay:160ms">
        <h3>📍 {t.training.locationTitle}</h3>
        <p>{t.training.address}</p>
        <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          {t.training.mapLink} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .training-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (min-width: 900px) {
    .training-grid { grid-template-columns: 1fr 1.2fr; align-items: start; }
  }
  .lead {
    margin-top: 1rem;
    font-size: 1.15em;
    color: var(--c-ink-soft);
  }
  .cards {
    display: grid;
    gap: 1.25rem;
  }
  .card {
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    box-shadow: var(--shadow);
  }
  .card h3 { margin-bottom: 1rem; }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
    border-top: 1px dashed var(--c-line);
  }
  .row:first-child { border-top: 0; }
  dt { font-weight: 700; }
  dd { color: var(--c-ink-soft); font-variant-numeric: tabular-nums; }
  .location {
    background: var(--c-accent);
  }
  .location p { margin-bottom: 1.25rem; font-weight: 500; }
</style>
